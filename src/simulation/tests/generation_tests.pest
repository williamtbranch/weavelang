// In pest, comments start with #
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ ";" ~ (!"\n" ~ ANY)* }

// Basic atoms
number = @{ ('0'..'9')+ }
identifier = @{ (ASCII_ALPHANUMERIC | "_" | "-")+ }
string_literal = @{ "\"" ~ ( (!"\"" ~ ANY)* ) ~ "\"" }

// Test Case components
level_def = { "(" ~ "#level" ~ number ~ ")" }
assert_level_val = { "AdvancedWeave" | "SimpleHybrid" }
assert_level = { "(" ~ "assert-level" ~ assert_level_val ~ ")" }
assert_text = { "(" ~ "assert-text" ~ string_literal ~ ")" }

adv_segs = { "(" ~ "adv-segments" ~ identifier* ~ ")" }
mod_segs = { "(" ~ "ms-segments" ~ identifier* ~ ")" }
simple_segs = { "(" ~ "ss-segments" ~ identifier* ~ ")" }
eng_spans = { "(" ~ "en-segments" ~ identifier* ~ ")" }
sentence_def = { "(" ~ "sentence" ~ (adv_segs | mod_segs | simple_segs | eng_spans)+ ~ ")" }

test_case_body = { (level_def | sentence_def | assert_level | assert_text)+ }
test_case = { "(" ~ "#test-case" ~ string_literal ~ test_case_body ~ ")" }

// --- Segment Definition components ---
diglot_def = { "(" ~ "#di" ~ identifier ~ identifier ~ identifier ~ ")" }
segment_part = { diglot_def | identifier }

// A part_list is a parenthesized list of parts.
part_list = { "(" ~ segment_part* ~ ")" }
// A lemma_list is a parenthesized list of identifiers.
lemma_list = { "(" ~ identifier* ~ ")" }

// A segment_body now requires a part_list, and has an optional lemma_list.
segment_body = { part_list ~ lemma_list? }
segment_def = { "(" ~ "#define-segment" ~ identifier ~ segment_body ~ ")" }

// Top-level definitions
max_lemmas = { "(" ~ "#max-lemmas" ~ number ~ ")" }
file_item = { max_lemmas | segment_def | test_case }

// The main rule to start parsing from
test_suite = { SOI ~ file_item* ~ EOI }