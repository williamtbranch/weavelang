(test-case "Lonely Punctuation Handling"
    (sentence
        (L0
            (S "El hombre dijo" (lem210 lem211 lem212))
            (S "[[El]] [[hombre]] [[dijo]]" (lem210 lem211 lem212))
            (ID
              (El lem210 The)
              (hombre lem211 man)
              (dijo lem212 said)
            )

            (S ": " ()) // Lonely punctuation segment
            (S ": " ())
            (ID)

            (S "\"¡fue bueno!\"" (lem213 lem214))
            (S "\"¡[[fue]] [[bueno]]!\"" (lem213 lem214))
            (ID
              (fue lem213 it-was)
              (bueno lem214 good)
            )
        )
        (L1
            (D
              (He lem10 Él t)
              (said lem11 dijo t)
              (it lem14 se f)
              (is lem12 es t)
              (late lem13 tarde t)
            )
            (E "[[He]] [[said]], \"[[it]] [[is]] [[late]].\"")
        )
    )

    (sub-test "L0 falls back and joins lonely punctuation correctly"
      (level 213)
      (assert-level AdvancedWeave)
      // FIX: Final assertion with correct spacing.
      (assert-text "El hombre dijo: \"¡fue good!\"")
    )
    (sub-test "L1 falls back to English and joins lonely punctuation correctly"
      (level 1)
      (assert-level SimpleHybrid)
      // FIX: Final assertion with correct spacing.
      (assert-text "He said, \"it is late.\"")
    )
)


(test-case "Phrase Diglot with Multiple Lemmas"
    (sentence
        (L0 (S "adv" (lem999)) // Fails L0
            (S "[[adv2]] [[adv3]]" (lem999))
            (ID
              (adv2 lem997 dummy_sub)
              (adv3 lem996 dummy_sub2)
            )
        )
        (L1
            (D 
                // A single diglot tuple for the single English token.
                // The source phrase is "Take a walk."
                // The lemmas are "lem8", "lem150", "lem95".
                // The target phrase is "dar un paseo."
                (Take__a__walk lem8__lem150__lem95 dar__un__paseo t)
            )
            (E "[[Take a walk]].") // A single atomic token.
        )
    )
    (sub-test "at level 200, substitutes the multi-lemma phrase"
        (level 200) // Knows all 3 lemmas.
        (assert-level SimpleHybrid)
        (assert-text "dar un paseo.")
    )
    (sub-test "at level 100, fails to substitute due to lem150"
        (level 100) // Does not know lem150.
        (assert-level SimpleHybrid)
        (assert-text "Take a walk.")
    )
)

(test-case "L1 Weaving with Multi-Word Atoms"
    (sentence
        (L0 // Dummy L0 data designed to fail the >50% inverse diglot rule
            (S "adv" (lem20000))
            (S "[[adv-mod1]] [[adv-mod2]]" (lem19999 lem19998))
            (ID 
                (adv-mod1 lem19997 eng-sub1)
                (adv-mod2 lem19996 eng-sub2)
            )
        )
        (L1
            (D 
                (A__certain__king lem1__lem2__lem3 Un__cierto__rey t)
                (had lem4 tenía t)
                (a lem5 un t)
                (garden lem998 jardín t)
            )
            (E "[[A certain king]] [[had]] [[a]] [[garden]].")
        )
    )
    (sub-test "at level 10, weaves phrases, not words"
        (level 10) 
        (assert-level SimpleHybrid)
        (assert-text "Un cierto rey tenía un garden.")
    )
)

(test-case "L0 Inverse Diglot Phrase Weaving"
    (sentence
        (L0
            (S "adv-seg1-text" (lem1999))
            (S "[[El]] [[gato]] [[se sentó]] [[en]] [[la]] [[alfombra]]." (lem1 lem2 lem3000 lem4 lem5 lem6 lem7))
            (ID
              (El lem1 The)
              (gato lem2 cat)
              (se__sentó lem3__lem4 sat__down)
              (en lem5 on)
              (la lem6 the)
              (alfombra lem1998 carpet) // lem998 is the poison pill
            )
        )
        (L1 // This is the fallback content
            (D (dummy lem2 dummy t))
            (E "[[L1 fallback text]]")
        )
    )

    (sub-test "at level 1000, L0 fails due to one unknown lemma in a phrase"
        (level 1000) // Knows everything except lem998
        (assert-level AdvancedWeave)
        // The weave fails on the last phrase, so it substitutes.
        (assert-text "El gato se sentó en la carpet.")
    )
    (sub-test "at level 5, L0 fails on multiple phrases"
        (level 5) // Only knows lem1-5. Fails on "gato", "se sentó", "alfombra".
        (assert-level AdvancedWeave)
        (assert-text "El gato se sentó en the carpet.")
    )
    (sub-test "at level 1, L0 fails completely and falls back to L1"
        (level 1) // Knows almost nothing. The substitution ratio is too high.
        (assert-level SimpleHybrid)
        (assert-text "L1 fallback text")
    )
)