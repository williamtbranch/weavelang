// ===========================================
// WeaveLang Test Suite - v11.4
// High-Level Tier Selection & Fallback Logic
// ===========================================

(test-case "High-Level Tier Selection and Fallback"
    (sentence
        (L0
            // L0 Tiers: Advanced and Moderate
            (S "ADVANCED TEXT" (lem900))
            (S "MODERATE TEXT" (lem700))
        )
        (L1 
            // 1. Basic Spanish: 3 word groups, 2 required lemmas (lem100, lem150)
            (BS "[[s-Basic]] [[s-Spanish]] [[s-Text]]" (lem100 lem150))

            // 2. Inverse Diglot Map
            (ID 
                (s-Basic lem100 e-basic-sub)
                (s-Spanish lem150 e-spanish-sub)
                (s-Text pn PROPER_NOUN) // Proper nouns are always known
            )

            // 3. Basic English: The final fallback template
            (BE "[[Basic]] [[Spanish]] [[Text]]")

            // 4. Forward Diglot Map for the final fallback
            (D 
                (Basic lem10 Básico t)
                (Spanish lem20 Español t)
                (e-Text pn Text p) // Proper noun is not substituted
            )
        )
    )

    // --- Test Set 1: L0 Weave Logic ---

    (sub-test "L0: Learner knows Advanced, chooses Advanced"
        (level (adv 1000) (mod 1000) (bas 0))
        (assert-level AdvancedWeave)
        (assert-text "ADVANCED TEXT")
    )

    (sub-test "L0: Learner fails Advanced, succeeds Moderate, chooses Moderate"
        (level (adv 500) (mod 800) (bas 0)) // Knows lem700 but not lem900
        (assert-level AdvancedWeave)
        (assert-text "MODERATE TEXT")
    )

    // --- Test Set 2: L1 Fallback Logic ---

    (sub-test "L1: L0 fails, 100% BS check PASSES, chooses BasicTarget"
        // Learner knows all required lemmas for the BS tier (lem100, lem150)
        (level (adv 0) (mod 0) (bas 200))
        (assert-level BasicTarget)
        (assert-text "s-Basic s-Spanish s-Text")
    )

    (sub-test "L1: L0/BS fail, 50% ID check PASSES, chooses InverseDiglot"
        // Fails L0. Fails BS 100% check (doesn't know lem150).
        // Checks ID: Knows "s-Basic" (lem100) and "s-Text" (pn). Fails "s-Spanish" (lem150).
        // Known words = 2 ("s-Basic", "s-Text"). Total words = 3. Ratio = 66%. PASS.
        (level (adv 0) (mod 0) (bas 120))
        (assert-level InverseDiglot)
        (assert-text "s-Basic e-spanish-sub s-Text") // <-- YOUR CORRECTION INTEGRATED HERE
    )

    (sub-test "L1: L0/BS/ID fail, falls back to BasicBaseDiglot"
        // Fails L0. Fails BS 100% check.
        // Checks ID: Knows "s-Text" (pn) only. Ratio = 33%. FAIL.
        (level (adv 0) (mod 0) (bas 5))
        (assert-level BasicBaseDiglot)
        (assert-text "Basic Spanish Text") // Knows no diglot words, so all English.
    )

    (sub-test "L1: Diglot substitution works in final fallback"
        // Fails L0/BS/ID.
        // For final BE fallback, knows "Básico" (lem10) but not "Español" (lem20).
        (level (adv 0) (mod 0) (bas 15))
        (assert-level BasicBaseDiglot)
        (assert-text "Básico Spanish Text")
    )
)

(test-case "BS 50% accounting basic"
    (sentence
        (L0
            (S "DUMMY-ADV" (lem9999))
            (S "DUMMY-MOD" (lem9998))
        )
        (L1 
            (BS "[[bss-worda]] [[bss-wordb]], [[bss-wordc bss-wordd bss-worde]]!" (lem1000))

            (ID 
                (bss-worda lem400 bse-worda)
                (bss-wordb lem500 bse-wordb)
                (bss-wordc__bss-wordd__bss-worde lem100__lem200__lem300 bss-wordc__bss-wordd__bss-worde)
            )

            (BE "DUMMY-BE")
            (D 
                (DUMMY-BE lem500 DUMMY-BEs t)
            )
        )
    )
    (sub-test "basic Spanish tier is known."
        (level (adv 0) (mod 0) (bas 1000))
        (assert-level BasicTarget)
        (assert-text "bss-worda bss-wordb, bss-wordc bss-wordd bss-worde!")
    )
    (sub-test "multiple words in word group tip scales in favor of 50% expression."
        (level (adv 0) (mod 0) (bas 300))
        (assert-level InverseDiglot)
        (assert-text "bse-worda bse-wordb, bss-wordc bss-wordd bss-worde!")
    )
    (sub-test "L1: 50% word instance check FAILS, choosing BasicBaseDiglot"
        // Fails L0 and BS 100%.
        // Checks ID: Learner only knows lem100. The multi-word group fails because
        // it requires lem200 and lem300 as well.
        // Tally: 0 known word instances out of 5. Ratio = 0%. FAIL.
        (level (adv 0) (mod 0) (bas 150))
        (assert-level BasicBaseDiglot)
        (assert-text "DUMMY-BE")
    )
)

(test-case "Complex sentence: comprehensive test"
    (sentence
        (L0
            //We always use pairs. The first in a pair is the first advanced segment, the last is the moderate.
            (S "a-word1 a-word2, " (lem940 lem10))
            (S "m-word1 m-word2, " (lem500))

            (S "a-word3 a-word4 a-word5 " (lem10 lem1000)) //flip low lemma insuring all lemmas checked
            (S "m-word3 m-word4 " (lem800 lem80))
            
            (S "a-word6 a-word7 a-word8!" (lem300 lem200 lem850))
            (S "m-word5 m-word6!" (lem80 lem400))
        )
        (L1 
            (BS "[[bss-worda]] [[bss-wordb]] [[bss-wordb2]], [[bss-wordc bss-wordd bss-worde]] [[bss-wordf]] [[bss-wordg]]!" (lem350 lem200 lem5 lem6))

            (ID 
                (bss-worda lem319 bse-worda)
                (bss-wordb lem331 bse-wordb)
                (bss-wordb2 lem333 bse-wordb2)
                (bss-wordc__bss-wordd__bss-worde lem100__lem200__lem336 bse-wordc__bse-wordd__bse-worde)
                (bss-wordf lem300 bse-wordf)
                (bss-wordg lem301 bse-wordg)
            )

            (BE "[[ee-worda]] [[ee-wordb]], [[ee-wordc ee-wordd]] [[ee-worde]] [[ee-wordf]]?")
            (D 
                (ee-worda lem250 es-worda t)
                (ee-wordb lem200 es-wordb t)
                (ee-wordc__ee-wordd lem300__lem330 es-wordc__es-wordd t)
                (ee-worde lem2 NO_SUB f)
                (ee-wordf lem50 es-wordf t)
            )
        )
    )
    //Start with basic locked levels
    (sub-test "AAA pattern AW"
        (level (adv 1001) (mod 1001) (bas 1001))
        (assert-level AdvancedWeave)
        (assert-text "a-word1 a-word2, a-word3 a-word4 a-word5 a-word6 a-word7 a-word8!")
    )
    (sub-test "ABA pattern AW"
        (level (adv 950) (mod 950) (bas 950))
        (assert-level AdvancedWeave)
        (assert-text "a-word1 a-word2, m-word3 m-word4 a-word6 a-word7 a-word8!")
    )
    (sub-test "BBA pattern AW"
        (level (adv 900) (mod 900) (bas 900))
        (assert-level AdvancedWeave)
        (assert-text "m-word1 m-word2, m-word3 m-word4 a-word6 a-word7 a-word8!")
    )
    (sub-test "BBB pattern AW"
        (level (adv 800) (mod 800) (bas 800))
        (assert-level AdvancedWeave)
        (assert-text "m-word1 m-word2, m-word3 m-word4 m-word5 m-word6!")
    )
    (sub-test "AAAAAA pattern BT"
        (level (adv 350) (mod 350) (bas 350))
        (assert-level BasicTarget)
        (assert-text "bss-worda bss-wordb bss-wordb2, bss-wordc bss-wordd bss-worde bss-wordf bss-wordg!")
    )
    (sub-test "AAAAAA pattern ID"
        (level (adv 349) (mod 349) (bas 349))
        (assert-level InverseDiglot)
        (assert-text "bss-worda bss-wordb bss-wordb2, bss-wordc bss-wordd bss-worde bss-wordf bss-wordg!")
    )
    (sub-test "AAABAA pattern ID"
        (level (adv 335) (mod 335) (bas 335))
        (assert-level InverseDiglot)
        (assert-text "bss-worda bss-wordb bss-wordb2, bse-wordc bse-wordd bse-worde bss-wordf bss-wordg!")
    )
    (sub-test "AABBAA pattern ID"
        (level (adv 332) (mod 332) (bas 332))
        (assert-level InverseDiglot)
        (assert-text "bss-worda bss-wordb bse-wordb2, bse-wordc bse-wordd bse-worde bss-wordf bss-wordg!")
    )
    (sub-test "TTTBT pattern BT - ABBBAA pattern ID Fails"
        (level (adv 330) (mod 330) (bas 330))
        (assert-level BasicBaseDiglot)
        (assert-text "es-worda es-wordb, es-wordc es-wordd ee-worde es-wordf?")
    )
    (sub-test "TTBBT pattern BT"
        (level (adv 315) (mod 315) (bas 315))
        (assert-level BasicBaseDiglot)
        (assert-text "es-worda es-wordb, ee-wordc ee-wordd ee-worde es-wordf?")
    )
    (sub-test "BTBBT"
        (level (adv 249) (mod 249) (bas 249))
        (assert-level BasicBaseDiglot)
        (assert-text "ee-worda es-wordb, ee-wordc ee-wordd ee-worde es-wordf?")
    )
    (sub-test "BBBBT"
        (level (adv 51) (mod 51) (bas 51))
        (assert-level BasicBaseDiglot)
        (assert-text "ee-worda ee-wordb, ee-wordc ee-wordd ee-worde es-wordf?")
    )
    (sub-test "BBBBB"
        (level (adv 1) (mod 1) (bas 1))
        (assert-level BasicBaseDiglot)
        (assert-text "ee-worda ee-wordb, ee-wordc ee-wordd ee-worde ee-wordf?")
    )
)

(test-case "Proper Noun Handling (V11.4 - Spanish Always, Corrected Logic)"
    (sentence
        (L0
            (S "DUMMY-ADV" (lem900))
            (S "DUMMY-MOD" (lem800))
        )
        (L1 
            (BS "[[s-que]] [[s-Alicia]] [[s-estaba]] [[s-allí]]." (lem100 lem150 lem200))
            (ID 
                (s-que lem100 e-that)
                (s-Alicia pn PROPER_NOUN)
                (s-estaba lem150 e-was)
                (s-allí lem200 e-there)
            )
            (BE "[[that]] [[Alice]] [[was]] [[there]].")
            (D 
                (that lem3 que t)
                (Alice pn Alicia t p) // Viable and a PN
                (was lem5 estaba t)
                (there lem80 allí t)
            )
        )
    )

    (sub-test "ID: Proper noun is always treated as known"
        // This test remains correct. The learner knows `s-que` and the PN `s-Alicia`.
        // 2/4 words known in ID check, 50% passes.
        (level (adv 0) (mod 0) (bas 120))
        (assert-level InverseDiglot)
        (assert-text "s-que s-Alicia e-was e-there.")
    )

    (sub-test "BE: Proper noun IS SUBSTITUTED even when other words are unknown"
        // Fails L0, BS, and ID 50% check. Falls to BE.
        // Learner's level is so low they know NONE of the regular words.
        (level (adv 0) (mod 0) (bas 1))
        (assert-level BasicBaseDiglot)
        // THE CRITICAL ASSERTION:
        // "que", "estaba", "allí" should fall back to English.
        // "Alice" MUST be substituted with "Alicia" because it's a viable proper noun.
        (assert-text "that Alicia was there.")
    )
)

(test-case "Punctuation Integrity During Diglot Substitution"
    (sentence
        (L0
            // Segment 1
            (S "\"¡Claro!\", exclamó el Rey; " (lem301 lem302 lem303 lem304))
            (S "\"¡Sí!\", dijo el Rey; " (lem201 lem202 lem203 lem204))

            // Segment 2
            (S "¿qué es ese estruendo?" (lem305 lem306 lem307 lem308))
            (S "¿qué es ese sonido?" (lem205 lem206 lem207 lem208))
        )
        (L1 
            (BS "\"¡[[Sí]]!\", [[dijo]] [[el]] [[Rey]]; ¿[[qué]] [[es]] [[ese]] [[sonido]]?" (lem201 lem202 lem203 lem204 lem205 lem206 lem207 lem208))
            (ID 
                (Sí lem201 Yes)
                (dijo lem202 said)
                (el lem203 the)
                (Rey lem204 King)
                (qué lem205 what)
                (es lem206 is)
                (ese lem207 that)
                (sonido lem208 sound) // This is the word that will be unknown
            )
            (BE "\"[[Yes]]\", [[said]] [[the]] [[King]]; [[what]] [[is]] [[that]] [[sound]]?")
            (D 
                (Yes lem1 Sí t)
                (said lem2 dijo t)
                (the lem3 el t)
                (King lem4 Rey t)
                (what lem5 qué t)
                (is lem6 es t)
                (that lem7 ese t)
                (sound lem8 sonido t) // This is the word that will be unknown
            )
        )
    )
    (sub-test "L1: Inverse Diglot substitution that handles punctuation"
        // Fails L0 & BS(100%).
        // Checks ID: Knows all lemmas EXCEPT `sonido` (lem208).
        // Known words = 7/8. Ratio = 87.5%. PASS.
        (level (adv 0) (mod 0) (bas 207))
        (assert-level InverseDiglot)
        // Renders the BS template, substituting the unknown 'sonido' with 'sound'.
        (assert-text "\"¡Sí!\", dijo el Rey; ¿qué es ese sound?")
    )
    (sub-test "L1: Final fallback (BE Diglot) substitution that handles punctuation"
        // Fails L0, BS, & ID.
        // Checks BE Diglot: Knows all lemmas EXCEPT `sonido` (lem8).
        (level (adv 0) (mod 0) (bas 7))
        (assert-level BasicBaseDiglot)
        // Renders the BE template, substituting known words and leaving 'sound' in English.
        (assert-text "\"Sí\", dijo el Rey; qué es ese sound?")
    )
)


(test-case "NO_SUB in Forward Diglot (BE) is handled correctly"
    (sentence
        (L0
            (S "DUMMY-ADV" (lem9999))
            (S "DUMMY-MOD" (lem9998))
        )    
        (L1
            (BS "[[dummy]]" (lem9997))
            (ID (dummy lem9996 dummy-sub))
            (BE "[[dsa1]] [[dsa2]] [[dsa3]] [[dsb1]] [[dsb2]] [[dsb3]]")
            (D
              (dsa1 lem8 NO_SUB t)
              (dsa2 lem9 NO_SUB t)
              (dsa3 lem3 NO_SUB f) // non-viable, should always be English
              (dsb1 lem11 NO_SUB t) // unknown lemma, should be English
              (dsb2 lem3 deb2 t) // viable and known, should be Spanish
              (dsb3 lem2 NO_SUB t)
            )
        )
      )
    
    (sub-test "BE Diglot correctly renders original English for NO_SUB mappings"
      // Fails L0, BS, and ID. Falls back to BE Diglot.
      // Learner knows lemmas up to 10.
      (level (adv 0) (mod 0) (bas 10))
      (assert-level BasicBaseDiglot)
      // dsa1, dsa2, dsa3, dsb3 are NO_SUB -> render English.
      // dsb1 is NO_SUB and lemma unknown -> render English.
      // dsb2 is viable and known -> render Spanish 'deb2'.
      (assert-text "dsa1 dsa2 dsa3 dsb1 deb2 dsb3")
    )
)

(test-case "L1: BE Diglot viability 'f' flag is respected"
    (sentence
        (L0
            (S "DUMMY-ADV" (lem9999))
            (S "DUMMY-MOD" (lem9998))
        )
        (L1 
            (BS "[[dummy]]" (lem9997))
            (ID (dummy lem9996 dummy-sub))
            (BE "[[dsa1]] [[dsa2]] [[dsa3]] [[dsb1]] [[dsb2]] [[dsb3]]")
            (D
              (dsa1 lem11 sp1 t)      // Viable, but lemma unknown
              (dsa2 lem9 sp2 t)      // Viable and known
              (dsa3 lem3 sp3 f)      // NOT viable, but known -> Should be English
              (dsb1 lem12 spb1 t)    // Viable, but lemma unknown
              (dsb2 lem3 spb2 f)     // NOT viable, but known -> Should be English
              (dsb3 lem2 spb3 t)     // Viable and known
            )
        )
      )
    
    (sub-test "BE Diglot 'f' flag forces English, even if lemma is known"
      // Fails L0, BS, and ID. Falls to BE Diglot. Learner knows lemmas up to 10.
      (level (adv 0) (mod 0) (bas 10))
      (assert-level BasicBaseDiglot)
      // dsa1, dsb1: English (unknown lemma)
      // dsa3, dsb2: English (viable=false)
      // dsa2, dsb3: Spanish (viable=true, known lemma)
      (assert-text "dsa1 sp2 dsa3 dsb1 dsb2 spb3")
    )
)


(test-case "L1: Inverse Diglot fails on unknown NO_SUB"
    (sentence
        (L0
            (S "DUMMY-ADV" (lem9999))
            (S "DUMMY-MOD" (lem9998))
        )
        (L1
            (BS "[[Una]] [[frase]] [[simple]] [[de]] [[prueba]]" (lem201 lem202 lem203 lem500 lem204))
            (ID
              (Una lem99 e-A)
              (frase lem98 e-phrase)
              (simple lem80 e-simple)
              (de lem500 NO_SUB) // This is the trigger. lem500 is unknown.
              (prueba lem204 e-test)
            )
            (BE "[[A]] [[simple]] [[test]]")
            (D
              (A lem1 A-es t)
              (simple lem2 simple-es t)
              (test lem3 test-es t)
            )
        )
    )

    (sub-test "ID check is vetoed by an unknown NO_SUB group, forcing fallback to BE"
      // Fails L0 & BS.
      // Checks ID: The `de` group requires lem500, which is unknown, AND is NO_SUB.
      // This makes the entire InverseDiglot render impossible.
      (level (adv 0) (mod 0) (bas 499))
      (assert-level BasicBaseDiglot)
      // Renders the BE diglot. Learner knows lem1,2,3.
      (assert-text "A-es simple-es test-es")
    )
)

(test-case "BE Diglot Punctuation Integrity"
    (sentence
        (L0
            (S "DUMMY-ADV" (lem9999))
            (S "DUMMY-MOD" (lem9998))
        )
        (L1 
            (BS "[[dummy]]" (lem9997))
            (ID (dummy lem9996 dummy-sub))
            (BE "“[[Who]] [[are]] [[you]]?” [[said]] [[the]] [[Caterpillar]].")
            (D 
              (Who lem10 Quién t)
              (are lem12 eres t)
              (you lem13 tú t)
              (said lem4 dijo t)
              (the lem5 el t)
              (Caterpillar lem6 Oruga f) // Not viable, so it will always be English
            )
        )
    )
    (sub-test "BE Diglot correctly preserves surrounding punctuation"
      // Fails L0, BS, and ID. Falls to BE Diglot.
      // Learner knows lemmas up to 5, so they know "dijo" and "el".
      (level (adv 0) (mod 0) (bas 5))
      (assert-level BasicBaseDiglot)
      // "Who", "are", "you" are unknown -> English.
      // "said", "the" are known -> Spanish.
      // "Caterpillar" is not viable -> English.
      // All punctuation must be perfectly preserved.
      (assert-text "“Who are you?” dijo el Caterpillar.")
    )
)

(test-case "Lonely Punctuation Handling"
    (sentence
        (L0
            // Segment 1
            (S "El hombre dijo" (lem212))
            (S "El hombre dijo" (lem212))

            // Segment 2: Lonely Punctuation. Represented as a segment with only background tokens.
            (S ": " ())
            (S ": " ())

            // Segment 3
            (S "\"¡fue bueno!\"" (lem214))
            (S "\"¡fue bueno!\"" (lem214))
        )
        (L1 
            (BS "[[Él]] [[dijo]], \"[[es]] [[tarde]].\"" (lem10 lem11 lem12 lem13))
            (ID 
                (Él lem10 He)
                (dijo lem11 said)
                (es lem12 is)
                (tarde lem13 late)
            )
            // The English version also contains the lonely punctuation implicitly.
            (BE "[[He]] [[said]], \"[[it]] [[is]] [[late]].\"")
            (D 
                (He lem10 Él t)
                (said lem11 dijo t)
                (it lem14 se f) // Not viable
                (is lem12 es t)
                (late lem13 tarde t)
            )
        )
    )
    (sub-test "L0 weave joins lonely punctuation correctly"
      // Fails Adv/Mod for segment 1 (lem212). Passes for seg 2 (no lemmas). Fails for seg 3 (lem214).
      // The whole sentence fails the L0 check.
      // Let's create a test that PASSES L0.
      (level (adv 0) (mod 215) (bas 0))
      (assert-level AdvancedWeave)
      // All moderate segments are known. The text should be joined perfectly.
      (assert-text "El hombre dijo: \"¡fue bueno!\"")
    )
)