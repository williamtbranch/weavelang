// ===========================================
// WeaveLang Test Suite - v8.0
// Uses unified, self-validating DSL
// ===========================================

(test-case "All advanced Segments - sentenceA"

    (sentence
        (L0
            (S "sa1 sa2 sa3" (lem99 lem95 lem97))
            (S "ma1 ma2 ma3" (lem44 lem55 lem46))
            (ID
              (ma1 lem35 rdea1)
              (ma2 lem36 rdea2)
              (ma3 lem37 rdea3)
            )
            
            (S "sb1 sb2 sb3" (lem88 lem89 lem87))
            (S "mb1 mb2 mb3" (lem41 lem41 lem54))
            (ID
              (mb1 lem1 rdeb1)
              (mb2 lem51 rdeb2)
              (mb3 lem3 rdeb3)
            )
            
            (S "sc1 sc2 sc3" (lem77 lem78 lem79))
            (S "mc1 mc2 mc3" (lem60 lem62 lem59))
            (ID
              (mc1 lem61 rdec1)
              (mc2 lem48 rdec2) //leve40 exceeds 50% rule at this point.
              (mc3 lem39 rdec3)
            )
        )

        (L1
            (S "ssa1 ssa2 ssa3" (lem33 lem35 lem37))
            (D
              (dsa1 lem35 dea1)
              (dsa2 lem36 dea2)
              (dsa3 lem37 dea3)
            )
            (E "dsa1 dsa2 dsa3")
            
            (S "ssb1 ssb2 ssb3" (lem41 lem38 lem37))
            (D
              (dsb1 lem17 deb1)
              (dsb2 lem18 deb2)
              (dsb3 lem19 deb3)
            )
            (E "dsb1 dsb2 dsb3")
            
            (S "ssc1 ssc2 ssc3" (lem37 lem38 lem39))
            (D
              (ec1 lem21 dec1)
              (ec2 lem22 dec2)
              (ec3 lem23 dec3)
            )
            (E "ec1 ec2 ec3" )
        )
    )
    (sub-test "Advanced weave at 100"
      (level 100)
      (assert-text "sa1 sa2 sa3 sb1 sb2 sb3 sc1 sc2 sc3")
      (assert-level AdvancedWeave) 
    )
    (sub-test "at level 90, falls back to Moderate Spanish in column A"
        (level 90)
        (assert-text "ma1 ma2 ma3 sb1 sb2 sb3 sc1 sc2 sc3")
        (assert-level AdvancedWeave) 
    )
    (sub-test "at level 80, falls back to Moderate Spanish in column A&B"
        (level 80)
        (assert-text "ma1 ma2 ma3 mb1 mb2 mb3 sc1 sc2 sc3")
        (assert-level AdvancedWeave) 
    )
    (sub-test "at level 70, falls back to Moderate Spanish in column A&B&C"
        (level 70)
        (assert-text "ma1 ma2 ma3 mb1 mb2 mb3 mc1 mc2 mc3")
        (assert-level AdvancedWeave) 
    )
    (sub-test "at level 60, falls back to Moderate Spanish in column A&B id word 3 of column C"
        (level 60)
        (assert-text "ma1 ma2 ma3 mb1 mb2 mb3 rdec1 mc2 mc3")
        (assert-level AdvancedWeave) 
    )
    (sub-test "at level 50, falls back to Moderate Spanish in column B id word 3 of column C"
        (level 50)
        (assert-text "ma1 ma2 ma3 mb1 rdeb2 mb3 rdec1 mc2 mc3")
        (assert-level AdvancedWeave) 
    )
    (sub-test "at level 40, falls back to L1 at this threshold"
        (level 40)
        (assert-text "ssa1 ssa2 ssa3 deb1 deb2 deb3 ssc1 ssc2 ssc3")
        (assert-level SimpleHybrid) 
    )
)

(test-case "Real World Bug - S26 from A Christmas Carol"
    (sentence
        (L0
            (S "sANo hay duda de" (lem23 lem15 lem150 lem16))
            (S "mANo hay duda de" (lem12 lem21 lem14 lem16)) 
            (ID 
                (mANo lem20 NO_SUB) 
                (hay lem19 NO_SUB) 
                (duda lem200 doubt) 
                (de lem15 NO_SUB)
            )
            
            (S "sBque Marley estaba muerto." (lem45 lem33 lem150))
            (S "mBque Marley estaba muerto." (que estar muerto))
            (ID 
                (mBque lem10 NO_SUB) 
                (Marley marley PROPER_NOUN) //We should never see "PROPER_NOUN" in final text. 
                (estaba lem5 is) 
                (muerto lem80 dead)
            )
        )
        (L1
            (S "No hay duda" (lem20 lem30 lem300))
            (D (There lem21 Hay t) (is lem2 NO_SUB f) (no ninguno ninguna t) (doubt dudar duda t))
            (E "There is no doubt")
            
            (S "de que Marley estaba muerto." (de que estar muerto))
            (D
              (that lem3 que t)
              (Marley lem1 PROPER_NOUN t) //PROPER_NOUN should never get used even if 't' flag set
              (was lem5 estaba t)
              (dead muerto muerto t)
            )
            (E "that Marley was dead.")
        )
    )
    (sub-test "at level 20, should produce L0 inverse diglot without literal PROPER_NOUN"
      (level 20)
      (assert-text "mANo hay doubt de mBque Marley estaba dead.")
    )
    (sub-test "at level 15, should always produce L1 diglot without literal PROPER_NOUN"
      (level 15)
      (assert-text "There is no doubt que Marley estaba dead.")
    )
    (sub-test "at level 1000, should choose AdvS"
        (level 1000)
        (assert-text "sANo hay duda de sBque Marley estaba muerto.")
        (assert-level AdvancedWeave) 
    )
)

(test-case "Fingerprint test for context-aware lemmas"
    (sentence
        (L0
            (S "adv-fails" (lem99))
            (S "word1 word2 word3" (lem10 lem20 lem98)) // lem98 is the poison pill
            (ID 
                (word1 lem10 eng1) 
                (word2 lem20 eng2) 
                (word3 lem30 eng3)
            )
        )
        (L1
            (S "l1-fallback" (lem1))
            (D (fallback-e lem2 fb-d t))
            (E "fallback-e")
        )
    )

    (sub-test "at level 50, proves separate lemma lists are used"
        (level 50)
        (assert-text "word1 word2 word3")
        (assert-level AdvancedWeave)
    )
)