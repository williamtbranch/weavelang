// ===========================================
// WeaveLang Test Suite - v10.0
// Uses multi-tier level definitions
// ===========================================

(test-case "Four-Tier Weaving Logic"
    (sentence
        (L0
            // Four segments now, in order: Advanced, Moderate, Basic, Simple
            (S "ADVANCED TEXT" (lem900))
            (S "MODERATE TEXT" (lem700))
            (S "BASIC TEXT" (lem400))
            (S "[[SIMPLE TEXT]]" (lem100))
            (ID (SIMPLE lem100 simple-eng-sub)) // Inverse Diglot still based on Simple
        )
        (L1 
            (D (base-eng lem10 simple-es-sub t)) // Forward Diglot still based on Simple
            (E "[[base-eng]]")
        )
    )

    (sub-test "Learner has only started the Simple tier"
        (level (sim 150) (bas 0) (mod 0) (adv 0))
        (assert-level AdvancedWeave)
        (assert-text "SIMPLE TEXT") // Knows lem100, so Simple text is used.
    )

    (sub-test "Learner has exhausted Simple, started Basic"
        (level (sim exhausted) (bas 500) (mod 0) (adv 0))
        (assert-level AdvancedWeave)
        (assert-text "BASIC TEXT") // Knows lem400, so Basic text is used.
    )
    
    (sub-test "Learner has exhausted Basic, started Moderate"
         (level (sim exhausted) (bas exhausted) (mod 800) (adv 0))
         (assert-level AdvancedWeave)
         (assert-text "MODERATE TEXT") // Knows lem700, so Moderate text is used.
    )

    (sub-test "Learner has exhausted Moderate, started Advanced"
         (level (sim exhausted) (bas exhausted) (mod exhausted) (adv 1000))
         (assert-level AdvancedWeave)
         (assert-text "ADVANCED TEXT") // Knows lem900, so Advanced text is used.
    )

    (sub-test "Learner fails all Spanish tiers, falls back to Inverse Diglot"
        (level (sim 50) (bas 0) (mod 0) (adv 0)) // Doesn't know lem100
        (assert-level AdvancedWeave)
        (assert-text "simple-eng-sub") // Falls back to the ID map.
    )
)

(test-case "Multi-Segment Cascade and Fallback"
    (sentence
        (L0
            // Segment 1 (A1): Has a moderately difficult word.
            (S "ADV-A1 " (lem800))
            (S "MOD-A1 " (lem650))
            (S "BAS-A1 " (lem450))
            (S "[[SIM-A1]] " (lem150))
            (ID (SIM-A1 lem150 sub-A1))

            // Segment 2 (A2): Has a very difficult word.
            (S "ADV-A2" (lem1200))
            (S "MOD-A2" (lem950))
            (S "BAS-A2" (lem500))
            (S "[[SIM-A2]]" (lem200))
            (ID (SIM-A2 lem200 sub-A2))
        )
        (L1 
            // L1 fallbacks are not relevant for this L0 test.
            (D
              (unused lem10 ED-unused t)
            )
            (E "[[unused]]")
        )
    )

    (sub-test "Learner knows Moderate words, but not very hard words"
        // This level can satisfy lem650 (MOD-A1) but not lem950 (MOD-A2).
        // It can, however, satisfy lem500 (BAS-A2).
        (level (sim exhausted) (bas exhausted) (mod 700) (adv 0))
        (assert-level AdvancedWeave)
        // We expect Segment 1 to resolve to Moderate, and Segment 2 to fall back to Basic.
        (assert-text "MOD-A1 BAS-A2")
    )

    (sub-test "Learner only knows Basic words, forcing both segments down"
        (level (sim exhausted) (bas 550) (mod 0) (adv 0))
        (assert-level AdvancedWeave)
        // We expect Segment 1 to resolve to Basic, and Segment 2 to also resolve to Basic.
        (assert-text "BAS-A1 BAS-A2")
    )
    
    (sub-test "Learner fails all but Simple, forcing one segment to Inverse Diglot"
        // Knows lem150 for A1, but does not know lem200 for A2.
        (level (sim 180) (bas 0) (mod 0) (adv 0))
        (assert-level AdvancedWeave)
        // We expect Segment 1 to resolve to Simple, and Segment 2 to fall back to its Inverse Diglot.
        (assert-text "SIM-A1 sub-A2")
    )
)
