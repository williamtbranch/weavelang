// ===========================================
// WeaveLang Test Suite - v5.2
// ===========================================

(test-case "All advanced Segments - sentenceA"

    (sentence
        (L0
            (S "sa1 sa2 sa3" (lem99 lem95 lem97))
            (S "ma1 ma2 ma3" (lem44 lem55 lem46))
            (ID
              (rdsa1 lem35 rdea1)
              (rdsa2 lem36 rdea2)
              (rdsa3 lem37 rdea3)
            )
            
            (S "sb1 sb2 sb3" (lem88 lem89 lem87))
            (S "mb1 mb2 mb3" (lem41 lem42 lem43))
            (ID
              (rdsb1 lem1 rdeb1)
              (rdsb2 lem1 rdeb2)
              (rdsb3 lem1 rdeb3)
            )
            
            (S "sc1 sc2 sc3" (lem77 lem78 lem79))
            (S "mc1 mc2 mc3" (lem60 lem62 lem59))
            
            // should not pass level 40 due to >50% swapping
            (ID
              (rdsc1 lem61 rdec1)
              (rdsc2 lem48 rdec2)
              (rdsc3 lem39 rdec3)
            )
        )

        (L1
            (S "ssa1 ssa2 ssa3" (lem33 lem35 lem37))
            (D
              (dsa1 lem35 dea1)
              (dsa2 lem36 dea2)
              (dsa3 lem37 dea3)
            )
            (E "ma1 ma2 ma3")
            
            (S "ssb1 ssb2 ssb3" (lem41 lem38 lem37))
            (D
              (dsb1 lem17 deb1)
              (dsb2 lem18 deb2)
              (dsb3 lem19 deb3)
            )
            (E "eb1 eb2 eb3")
            
            (S "ssc1 ssc2 ssc3" (lem37 lem38 lem39))
            (D
              (dsc1 lem21 dec1)
              (dsc2 lem22 dec2)
              (dsc3 lem23 dec3)
            )
            (E "ec1 ec2 ec3" )
        )
    )
    (sub-test "Advanced weave at 100"
      (level 100)
      (assert-text "sa1 sa2 sa3 sb1 sb2 sb3 sc1 sc2 sc3")
      (assert-level AdvancedWeave) 
    )
    (sub-test "at level 90, falls back to Moderate Spanish in column A"
        (level 90) // Learner does NOT know lem95, lem97, lem99
        (assert-text "ma1 ma2 ma3 sb1 sb2 sb3 sc1 sc2 sc3")
        (assert-level AdvancedWeave) 
    )
    (sub-test "at level 80, falls back to Moderate Spanish in column A&B"
        (level 80)
        (assert-text "ma1 ma2 ma3 mb1 mb2 mb3 sc1 sc2 sc3")
        (assert-level AdvancedWeave) 
    )
    (sub-test "at level 70, falls back to Moderate Spanish in column A&B&C"
        (level 70)
        (assert-text "ma1 ma2 ma3 mb1 mb2 mb3 mc1 mc2 mc3")
        (assert-level AdvancedWeave) 
    )
    (sub-test "at level 60, falls back to Moderate Spanish in column A&B id word 3 of column C"
        (level 60)
        (assert-text "ma1 ma2 ma3 mb1 mb2 mb3 rdec1 rdsc2 rdsc3")
        (assert-level AdvancedWeave) 
    )
    (sub-test "at level 50, falls back to Moderate Spanish in column B id word 3 of column C"
        (level 50)
        (assert-text "rdsa1 rdsa2 rdsa3 mb1 mb2 mb3 rdec1 rdsc2 rdsc3")
        (assert-level AdvancedWeave) 
    )
    (sub-test "at level 40, falls back to L1 at this threshold"
        (level 40)
        (assert-text "ssa1 ssa2 ssa3 dsb1 dsb2 dsb3 ssc1 ssc2 ssc3")
        (assert-level SimpleHybrid) 
    )
)


(test-case "Real World Bug - S26 from A Christmas Carol"
    (sentence
        // L0 Definition from JSON
        (L0
            // --- A1 ---
            (S "sANo hay duda de" (lem23 lem15 lem150 lem16))
            (S "mANo hay duda de" (lem12 lem15 lem14 lem16)) 
            (ID (idANo lem20 NO_SUB) (hay lem19 NO_SUB) (duda lem200 doubt) (de lem15 NO_SUB))
            // --- A2 ---
            (S "sBque Marley estaba muerto." (lem45 lem33 lem150))
            (S "mBque Marley estaba muerto." (que estar muerto))
            (ID (idBque lem10 NO_SUB) (Marley marley PROPER_NOUN) (estaba lem5 is) (muerto lem80 dead))
        )
        // L1 Definition from JSON
        (L1
            // --- S1 ---
            (S "No hay duda" (lem20 lem30 lem300))
            (D (There lem21 Hay t) (is lem2 NO_SUB f) (no ninguno ninguna t) (doubt dudar duda t))
            (E "There is no doubt")
            
            // --- S2 ---
            (S "de que Marley estaba muerto." (de que estar muerto))
            (D (that lem3 que t) (Marley marley PROPER_NOUN f) (was lem5 estaba t) (dead muerto muerto t))
            (E "that Marley was dead.")
        )
    )

    // Sub-Test 1: Replicate the bug at a low level (e.g., level 20)
    (sub-test "at level 20, should produce a clean L1 woven sentence"
      (level 20)
      (assert-text "mANo hay duda de idBque Marley estaba dead")
    )

    // Sub-Test 2: Baseline test at a high level
    (sub-test "at level 1000, should choose AdvS"
        (level 1000)
        (assert-text "sANo hay duda de sBque Marley estaba muerto.")
      (assert-level AdvancedWeave) 
    )
)


(test-case "Replicates PROPER_NOUN leak from Inverse Diglot Path"

    (sentence
        
        // L0 Definition:
        (L0
            (S "adv-phrase" (lem99)) // Fails: learner doesn't know lem99
            (S "Alicia sp2 sp3" (lem1 lem2 lem98)) // Fails: learner doesn't know lem98
            
            (ID 
                //alicia is not on lemma list. Should be added for just this sentence
                //proper noun lemmas get added to active lemmas just for sentence where they 
                //are marked by a diglot or inverse diglot
                (Alicia alicia PROPER_NOUN) 
                (spanish1 lem1 english1)
                (spanish2 lem2 english2)
            )
        )

        // L1 Definition:
        // We provide a valid L1 path as a fallback. If the L0 bug is fixed,
        // the engine will choose THIS path instead. But for now, we expect
        // the buggy L0 path to be chosen.
        (L1
            (S "this-is-the-correct-L1-fallback" (lem1))
            (D (d-i lem99 d-i f))
            (E "e-i")
        )
    )

    (sub-test "at level 1, leaks PROPER_NOUN from L0 Inverse Diglot path"
        (level 3) // Learner only knows lem1.
        
        //Failing case is "PROPER NOUN sp2 sp3"
        (assert-text "Alicia spanish1 spanish2")
      (assert-level AdvancedWeave) 
    )
)